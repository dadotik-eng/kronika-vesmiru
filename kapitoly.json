---
layout: null
permalink: /kapitoly.json
---
[{% for k in site.kapitoly %}{% assign era = site.data.ery | where: "id", k.obdobi | first %}{% assign zdroje = k.zdroje | default: k.prameny %}
{"slug": {{ k.url | split: "/" | last | jsonify }}, "id": {{ k.id | default: k.slug | jsonify }}, "typ": {{ k.typ | jsonify }}, "title": {{ k.title | jsonify }}, "date": {{ k.date | date: "%Y-%m-%d" | jsonify }}, "herni_rok": {{ k.herni_rok | jsonify }}, "obdobi": {{ k.obdobi | jsonify }}, "era": {{ era.nazev | default: k.era | jsonify }}, "soustava": {{ k.soustava | jsonify }}, "system": {{ site.data.soustavy[k.soustava] | default: k.system | jsonify }}, "vazby": {{ k.vazby | jsonify }}, "popis": {{ k.popis | jsonify }}, "overeni": {{ k.overeni | jsonify }}, "zdroje": {{ zdroje | jsonify }}, "prameny": {{ zdroje | jsonify }}, "url": {{ k.url | relative_url | jsonify }}, "html": {{ k.content | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}
]
